{
  "name": "@cloudcode/backend-support",
  "private": true,
  "version": "0.0.1",
  "description": "CloudCode backend-support modules for Mission Control / Gateway. Pure helpers; no execution.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
